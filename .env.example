# GETTING STARTED
# 1. Copy this file to .env
# 2. Add your Gemini API key (from https://aistudio.google.com/app/apikey)
# 3. Initialize Firebase:
#    - Run 'npm install -g firebase-tools'
#    - Run 'firebase login'
#    - Use the 'set_up_firebase' tool in the AI Studio environment OR
#    - Manually create 'firebase-applet-config.json' in the root directory with your Firebase config.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"
NEXT_PUBLIC_GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# Automatically set in AI Studio/Cloud Run, or use 'http://localhost:3000' for local dev.
APP_URL="http://localhost:3000"

# Note: Firebase configuration is loaded from /firebase-applet-config.json
# That file must exist and contain valid Firestore/Auth credentials.
