# Sanctuary Environment Configuration (Example)
# Copy this file to .env and fill in your actual keys.

# AI Providers
# Groq (Primary) - Get your key at https://console.groq.com/keys
GROQ_API_KEY="PASTE_YOUR_GROQ_API_KEY_HERE"

# Gemini (Fallback) - Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# Application Settings
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security Note: 
# All AI requests are handled server-side in /api/ai. 
# Do not use NEXT_PUBLIC_ for AI provider keys to prevent exposure.
